{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/register", "destination": "/frontend/register.html" },
    { "source": "/dashboard", "destination": "/frontend/pages/dashboard.html" },
    { "source": "/surveillance", "destination": "/frontend/pages/surveillance.html" },
    { "source": "/cameras", "destination": "/frontend/pages/cameras.html" },
    { "source": "/live", "destination": "/frontend/pages/live.html" },
    { "source": "/analytics", "destination": "/frontend/pages/analytics.html" },
    { "source": "/traffic-ai", "destination": "/frontend/pages/traffic-ai.html" },
    { "source": "/history", "destination": "/frontend/pages/history.html" },
    { "source": "/reports", "destination": "/frontend/pages/reports.html" },
    { "source": "/settings", "destination": "/frontend/pages/settings.html" },
    { "source": "/css/:path*", "destination": "/frontend/css/:path*" },
    { "source": "/js/:path*", "destination": "/frontend/js/:path*" },
    { "source": "/assets/:path*", "destination": "/frontend/assets/:path*" },
    { "source": "/pages/:path*", "destination": "/frontend/pages/:path*" }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
